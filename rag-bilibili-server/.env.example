# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com

# Alibaba Cloud DashScope API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Alibaba Cloud DashVector Configuration
DASHVECTOR_API_KEY=your_dashvector_api_key_here
DASHVECTOR_ENDPOINT=your_dashvector_endpoint_here

# Base64-encoded 32-byte key for encrypting temporary batch-import cookies
BATCH_IMPORT_CREDENTIAL_KEY=replace_with_base64_32_byte_key
